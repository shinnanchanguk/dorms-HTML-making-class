# ── OpenRouter API ─────────────────────────────────────────
# https://openrouter.ai/keys 에서 키를 발급받아 넣으세요.
OPENROUTER_API_KEY=sk-or-v1-여기에_본인_키_입력

# 사용할 AI 모델. OpenRouter 모델 ID면 무엇이든 가능합니다.
# (사진 업로드를 쓰려면 비전 지원 모델을 고르세요.)
AI_MODEL=google/gemini-2.5-flash

# ── 서버 ───────────────────────────────────────────────────
# Node 서버가 listen 할 포트. start.sh 가 자동 관리하므로 보통 그대로 둡니다.
PORT=3001

# 세션 쿠키 서명용 비밀키. 길고 무작위한 문자열로 바꾸세요.
SESSION_SECRET=여기에_길고_무작위한_문자열_입력

# ── 관리자 계정 (첫 실행 시 자동 생성) ─────────────────────
ADMIN_ID=admin
ADMIN_PASSWORD=꼭_변경하세요

# ── 학생 시드 계정 (첫 실행 시 자동 생성) ──────────────────
# 학번 형식: 1{반}{번호 2자리}.  예) 1반 1번 → 1101,  3반 17번 → 1317
SEED_CLASSES=5
SEED_STUDENTS_PER_CLASS=20

# ── (선택) 제출물·대화로그 외부 백업 폴더 ──────────────────
# 값을 넣으면 제출 HTML과 대화로그를 이 폴더에도 사본으로 저장합니다.
# 비워두면 비활성화되고, 데이터는 DB와 uploads/ 에만 저장됩니다.
# 예: /home/teacher/class-archive
LOCAL_ARCHIVE_DIR=
